AWS_PROFILE=            # set by the user locally, never committed with a value
AWS_REGION=us-east-1
# AWS session keys (or set AWS_PROFILE instead). They expire; never commit them.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0
BEDROCK_FALLBACK_MODEL_ID=mistral.ministral-3-8b-instruct
CAREEM_MCP_URL=http://127.0.0.1:8787/mcp
DEMO_MODE=true          # blocks checkout, sets sampleData flag
PORT=8080
WEB_ORIGIN=http://localhost:5173
MODEL_ADAPTER=auto      # auto | bedrock | stub (auto falls back to the marked stub if Bedrock is unreachable)
# Optional limits (defaults shown; see README "Limits")
# SOUQ_MAX_QTY_PER_LINE=20
# SOUQ_MAX_DISTINCT_ITEMS=40
# SOUQ_MAX_BASKET_AED=2000
# SOUQ_MIN_BUDGET_AED=1
# SOUQ_MAX_BUDGET_AED=5000
# SOUQ_MIN_CUT_PERCENT=1
# SOUQ_MAX_CUT_PERCENT=90
# SOUQ_MAX_MESSAGE_CHARS=4000
# SOUQ_MAX_TOOL_TURNS=8
# SOUQ_MAX_INVALID_TOOL_CALLS=3
# SOUQ_TURN_TIMEOUT_MS=240000
